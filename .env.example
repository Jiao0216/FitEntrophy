# OpenAI（推荐：设置 OPENAI_API_KEY 后搭配生成走 OpenAI）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# auto | openai | qwen — auto 时有 OPENAI_API_KEY 则用 OpenAI
LLM_PROVIDER=auto
# auto | demo | live — auto 时无 LLM Key 则走演示数据
DEMO_MODE=auto

# Qwen（DashScope OpenAI-compatible，未配置 OpenAI 时使用）
QWEN_API_KEY=
# 可选，默认见 config.py
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Bright Data Unlocker (https://api.brightdata.com/request)
BRIGHTDATA_API_KEY=
# Zone name from Bright Data control panel (Web Unlocker)
BRIGHTDATA_ZONE=web_unlocker1

# EverOS (Evermind hackathon stack) — optional long-term memory
EVEROS_API_KEY=
EVEROS_USER_ID=agent-forge-demo

# FASHN Virtual Try-On (https://docs.fashn.ai/) — optional
FASHN_API_KEY=
# FASHN_API_BASE=https://api.fashn.ai
# 预置 6 张模特图（一次性）: python scripts/generate_mannequin_assets.py → assets/mannequins/*.jpg

# Actionbook: install CLI (`npm i -g @actionbookdev/cli`) + set to 1 to enrich prompts
ACTIONBOOK_CLI_HINTS=0

# AgentField control plane (only if you `app.serve()` separately — Streamlit UI does not require it)
AGENTFIELD_SERVER=
AGENTFIELD_LOG_LEVEL=ERROR
# Streamlit 本地跑 app 时建议 false，避免 stdout 被 tee 后与 Streamlit 关机日志冲突
# AGENTFIELD_LOGS_ENABLED=false

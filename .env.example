# OpenAI (recommended: set OPENAI_API_KEY for outfit generation)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# auto | openai | qwen — auto uses OpenAI if OPENAI_API_KEY is set
LLM_PROVIDER=auto
# auto | demo | live — auto uses demo data when no LLM key is present
DEMO_MODE=auto

# Qwen (DashScope OpenAI-compatible, used when OpenAI is not configured)
QWEN_API_KEY=
# Optional, defaults in config.py
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Bright Data Unlocker (https://api.brightdata.com/request)
BRIGHTDATA_API_KEY=
# Zone name from Bright Data control panel (Web Unlocker)
BRIGHTDATA_ZONE=web_unlocker1

# EverOS (Evermind hackathon stack) — optional long-term memory
EVEROS_API_KEY=
EVEROS_USER_ID=agent-forge-demo

# FASHN Virtual Try-On (https://docs.fashn.ai/) — optional
FASHN_API_KEY=
# FASHN_API_BASE=https://api.fashn.ai
# Pre-generate 6 model images (one-time): python scripts/generate_mannequin_assets.py → assets/mannequins/*.jpg

# Actionbook: install CLI (`npm i -g @actionbookdev/cli`) + set to 1 to enrich prompts
ACTIONBOOK_CLI_HINTS=0

# AgentField control plane (only if you `app.serve()` separately — Streamlit UI does not require it)
AGENTFIELD_SERVER=
AGENTFIELD_LOG_LEVEL=ERROR
# Set to false when running Streamlit locally to avoid stdout conflicts
# AGENTFIELD_LOGS_ENABLED=false
